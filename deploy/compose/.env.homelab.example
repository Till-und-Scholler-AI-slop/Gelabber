# Existing Caddy on the host. Copy to `.env`, then `docker compose up -d`.
# Uses compose.yaml + compose.homelab.yaml (no bundled Caddy).
# Passwords have no defaults: fill in every empty *_PASSWORD (see .env.example).
#
# Smaller change, no overlay: GELABBER_HTTP_BIND=127.0.0.1 GELABBER_HTTP_PORT=8088
# and reverse_proxy that port with `header_up Host {hostport}`.

COMPOSE_FILE=compose.yaml:compose.homelab.yaml
GELABBER_NETWORK=gelabber

GELABBER_WEB_BIND=127.0.0.1
GELABBER_WEB_PORT=8088
# The API believes X-Forwarded-For (the client address its rate limits
# count): never publish its port beyond loopback or a network only your
# Caddy can reach, or anyone there picks their own address.
GELABBER_API_BIND=127.0.0.1
GELABBER_API_PORT=18080
# Media believes X-Forwarded-For as well (its cap on sockets that have not
# joined a call counts per client): same rule as the API port.
GELABBER_MEDIA_BIND=127.0.0.1
GELABBER_MEDIA_PORT=18081

API_COOKIE_SECURE=true

POSTGRES_USER=gelabber
POSTGRES_PASSWORD=
POSTGRES_DB=gelabber
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

REDIS_BIND=127.0.0.1
REDIS_PORT=6379

MINIO_ROOT_USER=gelabber
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=gelabber
# The API signs in as this bucket-scoped user (minio-init creates it), not as root.
MINIO_APP_USER=gelabber-api
MINIO_APP_PASSWORD=
MINIO_API_BIND=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_BIND=127.0.0.1
MINIO_CONSOLE_PORT=9001
# Without a second domain: ATTACHMENT_DELIVERY=proxy below; uploads and
# attachments then go through the API and the MinIO vhost is not needed.
#
# Browser PUTs / signed GETs need a dedicated MinIO vhost (Caddyfile.homelab).
# Editing THIS Compose .env does NOT export variables to an external Caddy
# (systemd, another compose stack, etc.). Copy/import both site blocks into the
# real Caddy config, then set domain (+ upstream) on that Caddy service/container
# OR hardcode them in the Caddyfile. Validate and reload Caddy afterwards.
#
# Host vs full URL (keep both in sync; no path prefix — Presigns sign Host+path):
#   GELABBER_MINIO_DOMAIN=minio.example.com          # Caddy site address / Host
#   MINIO_PUBLIC_ENDPOINT=https://minio.example.com  # API signs this URL for the browser;
#                                                    # web's Content-Security-Policy allows it
# If MINIO_API_PORT changes, adjust GELABBER_MINIO_UPSTREAM (Docker-net: minio:9000).
# For .home.arpa, trust the local Caddy CA on browser clients (Local HTTPS).
# Docs: https://caddyserver.com/docs/caddyfile/concepts#environment-variables
#       https://caddyserver.com/docs/automatic-https#local-https
GELABBER_MINIO_DOMAIN=minio.home.arpa
MINIO_PUBLIC_ENDPOINT=https://minio.home.arpa
MINIO_API_CORS_ALLOW_ORIGIN=https://gelabber.home.arpa
# redirect (MinIO vhost above) or proxy (through the API, no vhost).
ATTACHMENT_DELIVERY=redirect

# Overlay skips Gelabber coturn (3478 is usually taken). Point at yours.
# From a container, 127.0.0.1 is wrong — LAN IP or host.docker.internal.
# Second coturn: COMPOSE_PROFILES=bundled-coturn TURN_PORT=3479
#   TURN_RELAY_MIN=49210 TURN_RELAY_MAX=49250
#   TURN_URLS is the API ticket (browsers). The SFU does not read it.
#   Include turn:HOST:PORT?transport=tcp if the external TURN supports TCP.
TURN_PORT=3478
TURN_PUBLIC_HOST=192.168.1.10
TURN_EXTERNAL_IP=192.168.1.10
TURN_USERNAME=gelabber
TURN_PASSWORD=
# Do not set TURN_AUTH_SECRET for an external coturn that still uses
# username/password. Setting it makes tickets send REST HMAC credentials.
# To migrate that server: configure it with the same private secret
# (`use-auth-secret` / `static-auth-secret`), then set TURN_AUTH_SECRET here.
#TURN_AUTH_SECRET=
TURN_REALM=gelabber.home.arpa
MEDIA_ADVERTISED_IP=192.168.1.10

# Optional GIF search, see deploy/README.md ("GIFs"). Empty: off.
#KLIPY_API_KEY=
#KLIPY_CONTENT_FILTER=medium
#API_RATE_GIF_PER_MIN=30
#API_RATE_GIF_MEDIA_PER_MIN=240

# Optional Web Push for direct messages and mentions while the app is
# closed, see deploy/README.md ("Push notifications"). Empty: off.
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:admin@example.org
# Optional account mail: address confirmation and password reset, see
# deploy/README.md ("Account mail"). Empty SMTP_HOST: off.
#SMTP_HOST=
# starttls (default, port 587), tls (465) or none (25, relay on a private
# network; refused together with a password).
#SMTP_SECURITY=starttls
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#MAIL_FROM=Gelabber <noreply@example.org>
# Where people open Gelabber; links in the mails point here.
#APP_PUBLIC_URL=https://chat.example.org
# Link previews, see deploy/README.md ("Link previews"). On by default.
#API_LINK_PREVIEWS=true
#API_LINK_PREVIEW_DENY_HOSTS=
#API_RATE_PREVIEW_PER_MIN=10
# Postgres connections of the API, see deploy/README.md ("Database connections").
#API_DB_MAX_CONNECTIONS=20

PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
