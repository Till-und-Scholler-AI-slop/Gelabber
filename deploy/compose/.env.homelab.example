# Homelab with an existing Caddy. Copy to `.env` in this directory.
# `docker compose up -d` then uses compose.yaml + compose.homelab.yaml
# (no bundled Caddy). UDP still publishes on the host.
#
# Alternative without the overlay: keep the bundled Caddy on loopback
# (`GELABBER_HTTP_BIND=127.0.0.1`, `GELABBER_HTTP_PORT=8088`) and
# reverse_proxy that one port from your Caddy with `header_up Host {host}`.

COMPOSE_FILE=compose.yaml:compose.homelab.yaml
GELABBER_NETWORK=gelabber

GELABBER_WEB_BIND=127.0.0.1
GELABBER_WEB_PORT=8088
GELABBER_API_BIND=127.0.0.1
GELABBER_API_PORT=18080
GELABBER_MEDIA_BIND=127.0.0.1
GELABBER_MEDIA_PORT=18081

# Browser origin behind TLS. Session cookies need Secure.
API_COOKIE_SECURE=true

POSTGRES_USER=gelabber
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gelabber
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

REDIS_BIND=127.0.0.1
REDIS_PORT=6379

MINIO_ROOT_USER=gelabber
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=gelabber
MINIO_API_BIND=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_BIND=127.0.0.1
MINIO_CONSOLE_PORT=9001
# Browser PUTs. Same host you put in Caddyfile.homelab (or :9000 on LAN).
MINIO_PUBLIC_ENDPOINT=https://minio.home.arpa
MINIO_API_CORS_ALLOW_ORIGIN=https://gelabber.home.arpa

# coturn 4.18.0 — UDP is published here, not on Caddy.
# Behind NAT: TURN_EXTERNAL_IP=WAN/LAN (e.g. 203.0.113.10/192.168.1.10).
TURN_PORT=3478
TURN_PUBLIC_HOST=192.168.1.10
TURN_EXTERNAL_IP=192.168.1.10
TURN_USERNAME=gelabber
TURN_PASSWORD=change-me-turn
TURN_REALM=gelabber.home.arpa
# SFU host ICE (published 10000–10031/udp). Address the browser can reach.
MEDIA_ADVERTISED_IP=192.168.1.10

# Observability stays on the host ports (not through your Caddy).
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
