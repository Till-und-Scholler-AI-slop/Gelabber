# cp .env.example .env, fill in the passwords below, docker compose up
# TCP entry is Caddy. UDP (TURN + SFU ICE) is published beside it.
#
# Passwords have no defaults; Compose refuses to start without them. One way:
#   for key in POSTGRES_PASSWORD MINIO_ROOT_PASSWORD MINIO_APP_PASSWORD TURN_PASSWORD; do
#     sed -i "s/^$key=$/$key=$(openssl rand -hex 24)/" .env; done
# POSTGRES_PASSWORD only takes effect when the database volume is created.

# Plain HTTP serves this machine only (http://localhost). Signing in from
# another machine needs TLS in front and API_COOKIE_SECURE=true, see
# deploy/README.md ("Security"). API_ALLOW_PLAIN_HTTP=true is for a trusted
# test network only: session cookies then cross it unencrypted.
GELABBER_HTTP_BIND=127.0.0.1
GELABBER_HTTP_PORT=80
API_COOKIE_SECURE=false
#API_ALLOW_PLAIN_HTTP=false

POSTGRES_USER=gelabber
POSTGRES_PASSWORD=
POSTGRES_DB=gelabber
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

REDIS_BIND=127.0.0.1
REDIS_PORT=6379

MINIO_ROOT_USER=gelabber
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=gelabber
# The API signs in as this bucket-scoped user (minio-init creates it), not as root.
MINIO_APP_USER=gelabber-api
MINIO_APP_PASSWORD=
MINIO_API_BIND=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_BIND=127.0.0.1
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_API_CORS_ALLOW_ORIGIN=*

# 3478 taken: TURN_PORT=3479 and a free relay range, or the homelab overlay.
TURN_BIND=0.0.0.0
TURN_PORT=3478
TURN_RELAY_MIN=49160
TURN_RELAY_MAX=49200
TURN_PUBLIC_HOST=127.0.0.1
# Compose offers UDP and TCP TURN by default. A TURN_URLS override must
# include turn:HOST:PORT?transport=tcp to retain the TCP fallback.
TURN_EXTERNAL_IP=127.0.0.1
TURN_USERNAME=gelabber
TURN_PASSWORD=
# Leave unset for static username/password (bundled coturn and an external
# TURN that already checks those). REST: set a private secret here AND on
# coturn (`--use-auth-secret` / `--static-auth-secret`, same value). Do not
# use gelabberturnsecret — the API and bundled coturn reject it.
#TURN_AUTH_SECRET=
#TURN_CRED_TTL_SECS=21600
TURN_REALM=gelabber.local
MEDIA_ADVERTISED_IP=127.0.0.1

# Optional GIF search, see deploy/README.md ("GIFs"). Empty: off.
#KLIPY_API_KEY=
#KLIPY_CONTENT_FILTER=medium
#API_RATE_GIF_PER_MIN=30
#API_RATE_GIF_MEDIA_PER_MIN=240

# Optional Web Push for direct messages and mentions while the app is
# closed, see deploy/README.md ("Push notifications"). Empty: off.
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:admin@example.org
# Optional account mail: address confirmation and password reset, see
# deploy/README.md ("Account mail"). Empty SMTP_HOST: off.
#SMTP_HOST=
# starttls (default, port 587), tls (465) or none (25, relay on a private
# network; refused together with a password).
#SMTP_SECURITY=starttls
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#MAIL_FROM=Gelabber <noreply@example.org>
# Where people open Gelabber; links in the mails point here.
#APP_PUBLIC_URL=https://chat.example.org
# Link previews, see deploy/README.md ("Link previews"). On by default.
#API_LINK_PREVIEWS=true
#API_LINK_PREVIEW_DENY_HOSTS=
#API_RATE_PREVIEW_PER_MIN=10

# Optional: docker compose -f compose.yaml -f compose.observability.yaml up -d
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
