# Copy to `.env` in this directory, then: docker compose up
# Dev entry is Caddy on GELABBER_HTTP_PORT (TCP only; no UDP on the proxy).

GELABBER_HTTP_PORT=80

POSTGRES_USER=gelabber
POSTGRES_PASSWORD=gelabber
POSTGRES_DB=gelabber
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=gelabber
MINIO_ROOT_PASSWORD=gelabbergelabber
MINIO_BUCKET=gelabber
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_API_CORS_ALLOW_ORIGIN=*

# coturn 4.18.0 — UDP is published here, not on Caddy.
TURN_PORT=3478
TURN_PUBLIC_HOST=127.0.0.1
TURN_EXTERNAL_IP=127.0.0.1
TURN_USERNAME=gelabber
TURN_PASSWORD=gelabberturn
TURN_REALM=gelabber.local
# SFU host ICE (published 10000–10031/udp, not Caddy). Reachable from the browser.
MEDIA_ADVERTISED_IP=127.0.0.1

# Observability profile (`docker compose --profile observability up`).
# Prometheus scrapes api/media internally; Grafana is http://localhost:3000
# (admin / gelabber, anonymous Viewer).
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=gelabber
