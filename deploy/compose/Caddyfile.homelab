# Host Caddy (systemd or another stack). TLS stays with you.
# Import this site block, or copy it. `header_up Host {host}` is required
# (`/ws` compares Origin to Host).
#
# Caddy container on network `gelabber`:
#   GELABBER_API_UPSTREAM=api:8080
#   GELABBER_WEB_UPSTREAM=web:80
#   GELABBER_MEDIA_UPSTREAM=media:8081
#   GELABBER_MINIO_UPSTREAM=minio:9000

{$GELABBER_DOMAIN:gelabber.home.arpa} {
	encode gzip

	handle /health {
		reverse_proxy {$GELABBER_API_UPSTREAM:127.0.0.1:18080} {
			header_up Host {host}
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
				read_timeout 10s
				write_timeout 10s
			}
		}
	}

	handle /ready {
		reverse_proxy {$GELABBER_API_UPSTREAM:127.0.0.1:18080} {
			header_up Host {host}
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
				read_timeout 10s
				write_timeout 10s
			}
		}
	}

	handle /ws {
		reverse_proxy {$GELABBER_API_UPSTREAM:127.0.0.1:18080} {
			header_up Host {host}
			transport http {
				dial_timeout 5s
				read_timeout 0
				write_timeout 0
			}
		}
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy {$GELABBER_API_UPSTREAM:127.0.0.1:18080} {
			header_up Host {host}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 60s
				write_timeout 60s
			}
		}
	}

	@media path /media /media/*
	handle @media {
		reverse_proxy {$GELABBER_MEDIA_UPSTREAM:127.0.0.1:18081} {
			header_up Host {host}
			transport http {
				dial_timeout 5s
				read_timeout 0
				write_timeout 0
			}
		}
	}

	handle {
		reverse_proxy {$GELABBER_WEB_UPSTREAM:127.0.0.1:8088} {
			header_up Host {host}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 30s
				write_timeout 30s
			}
		}
	}
}

# Browser uploads and authenticated attachment redirects use this host.
# Keep it in sync with MINIO_PUBLIC_ENDPOINT: S3 presigns include both Host
# and path, so forwarding the upload through the app vhost or rewriting it
# makes every PUT fail with SignatureDoesNotMatch.
{$GELABBER_MINIO_DOMAIN:minio.home.arpa} {
	reverse_proxy {$GELABBER_MINIO_UPSTREAM:127.0.0.1:9000} {
		# Preserve Host including non-default port (e.g. :8443) for S3 signatures.
		# {host} strips the port; HTTP upstreams already pass Host by default, but
		# {hostport} keeps intent clear if the upstream later becomes HTTPS.
		header_up Host {hostport}
	}
}
