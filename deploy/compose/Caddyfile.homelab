# Host Caddy (systemd or another stack). TLS stays with you.
# Import this site block, or copy it. `header_up Host {hostport}` is required
# (`/ws` compares Origin to Host, including a non-default port such as :8443;
# `{host}` would drop the port and every WebSocket handshake would be 403).
# With API_COOKIE_SECURE=true, the overlay's default, `/ws` also refuses pages
# from `http://` origins: the app is served over HTTPS only.
#
# The API keys its rate limits, and media its cap on sockets that have not
# joined a call, by the rightmost X-Forwarded-For entry, so every API and
# media upstream below gets exactly one, the client as this Caddy sees it
# ({client_ip}). Behind a CDN or tunnel that is the CDN; to let Caddy
# believe the client address the CDN reports, add its ranges to the global
# options at the top of your Caddyfile:
#   {
#       servers {
#           trusted_proxies static <CDN or tunnel ranges>
#           trusted_proxies_strict
#       }
#   }
# The API and media believe X-Forwarded-For from whoever reaches them: never
# publish their ports (GELABBER_API_BIND, GELABBER_MEDIA_BIND) beyond loopback
# or a network only this Caddy uses.
#
# Caddy container on network `gelabber`:
#   GELABBER_API_UPSTREAM=api:8080
#   GELABBER_WEB_UPSTREAM=web:80
#   GELABBER_MEDIA_UPSTREAM=media:8081
#   GELABBER_MINIO_UPSTREAM=minio:9000

{$GELABBER_DOMAIN:gelabber.home.arpa} {
	encode zstd gzip

	handle /health {
		reverse_proxy {$GELABBER_API_UPSTREAM:127.0.0.1:18080} {
			header_up Host {hostport}
			header_up X-Forwarded-For {client_ip}
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
				read_timeout 10s
				write_timeout 10s
			}
		}
	}

	handle /ready {
		reverse_proxy {$GELABBER_API_UPSTREAM:127.0.0.1:18080} {
			header_up Host {hostport}
			header_up X-Forwarded-For {client_ip}
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
				read_timeout 10s
				write_timeout 10s
			}
		}
	}

	handle /ws {
		reverse_proxy {$GELABBER_API_UPSTREAM:127.0.0.1:18080} {
			header_up Host {hostport}
			header_up X-Forwarded-For {client_ip}
			transport http {
				dial_timeout 5s
				read_timeout 0
				write_timeout 0
			}
		}
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy {$GELABBER_API_UPSTREAM:127.0.0.1:18080} {
			header_up Host {hostport}
			header_up X-Forwarded-For {client_ip}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 60s
				write_timeout 60s
			}
		}
	}

	# Prometheus scrapes media:8081/metrics on the compose network; media itself
	# no longer serves /media/metrics. Keep this rule for older media images.
	handle /media/metrics {
		respond 404
	}

	@media path /media /media/*
	handle @media {
		reverse_proxy {$GELABBER_MEDIA_UPSTREAM:127.0.0.1:18081} {
			header_up Host {hostport}
			header_up X-Forwarded-For {client_ip}
			transport http {
				dial_timeout 5s
				read_timeout 0
				write_timeout 0
			}
		}
	}

	handle {
		reverse_proxy {$GELABBER_WEB_UPSTREAM:127.0.0.1:8088} {
			header_up Host {hostport}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 30s
				write_timeout 30s
			}
		}
	}
}

# Browser uploads and authenticated attachment redirects use this host.
# Keep it in sync with MINIO_PUBLIC_ENDPOINT: S3 presigns include both Host
# and path, so forwarding the upload through the app vhost or rewriting it
# makes every PUT fail with SignatureDoesNotMatch. Not needed with
# ATTACHMENT_DELIVERY=proxy: the API carries uploads and attachments.
{$GELABBER_MINIO_DOMAIN:minio.home.arpa} {
	reverse_proxy {$GELABBER_MINIO_UPSTREAM:127.0.0.1:9000} {
		# Preserve Host including non-default port (e.g. :8443) for S3 signatures.
		# {host} strips the port; HTTP upstreams already pass Host by default, but
		# {hostport} keeps intent clear if the upstream later becomes HTTPS.
		header_up Host {hostport}
	}
}
