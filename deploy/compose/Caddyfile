{
	auto_https off
}

# TCP only. coturn (3478/udp + relay) and SFU host ICE bind their own
# UDP — do not force media UDP through this proxy.
#
# Timeouts: short on health probes, bounded on JSON /api, unlimited
# read/write on WebSockets so they are not killed by idle heartbeats.
:80 {
	handle /health {
		reverse_proxy api:8080 {
			# /ws compares Origin to Host. Default Host is the upstream
			# dial address (`api:8080`) and fails the same-origin check.
			header_up Host {host}
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
				read_timeout 10s
				write_timeout 10s
			}
		}
	}

	handle /ready {
		reverse_proxy api:8080 {
			header_up Host {host}
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
				read_timeout 10s
				write_timeout 10s
			}
		}
	}

	# Native WS gateway (issue #6). Caddy upgrades automatically.
	handle /ws {
		reverse_proxy api:8080 {
			header_up Host {host}
			transport http {
				dial_timeout 5s
				read_timeout 0
				write_timeout 0
			}
		}
	}

	# `handle` takes one matcher. Two path tokens (`/api /api/*`) are a
	# parse error on Caddy 2.11. Named matchers keep /api and /api/*.
	@api path /api /api/*
	handle @api {
		reverse_proxy api:8080 {
			header_up Host {host}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 60s
				write_timeout 60s
			}
		}
	}

	@media path /media /media/*
	handle @media {
		reverse_proxy media:8081 {
			header_up Host {host}
			transport http {
				dial_timeout 5s
				read_timeout 0
				write_timeout 0
			}
		}
	}

	handle {
		reverse_proxy web:80 {
			header_up Host {host}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 30s
				write_timeout 30s
			}
		}
	}
}
