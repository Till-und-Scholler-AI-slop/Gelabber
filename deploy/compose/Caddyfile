{
	auto_https off
	# This Caddy's peer is the operator's proxy in front, the Docker gateway
	# (on Docker Desktop an address of its internal network) or, with a
	# widened GELABBER_HTTP_BIND, the client itself. Peers in
	# GELABBER_TRUSTED_PROXIES (Compose default private_ranges, empty trusts
	# none) may report the client in X-Forwarded-For; strict mode reads it
	# right to left and skips trusted hops, so an entry the client wrote
	# itself never wins unless the client's own address is trusted too: a
	# LAN client under private_ranges, or any client where Docker hands
	# connections over from one private address (rootless Docker, Docker
	# Desktop, IPv6 to an IPv4-only network); see deploy/README.md, "Client
	# addresses".
	servers {
		trusted_proxies static {$GELABBER_TRUSTED_PROXIES}
		trusted_proxies_strict
	}
}

# TCP only. coturn and SFU ICE bind UDP themselves.
# /ws compares Origin to Host — pass Host through or the handshake is 403.
# {hostport}, not {host}: the browser's Origin carries a non-default port
# (GELABBER_HTTP_PORT, a proxy on :8443), and {host} would drop it.
# The API keys its rate limits, and media its cap on sockets that have not
# joined a call, by the rightmost X-Forwarded-For entry, so both get exactly
# one: the client address resolved above ({client_ip}).
:80 {
	# API JSON and whatever the web container did not compress itself.
	encode zstd gzip

	handle /health {
		reverse_proxy api:8080 {
			header_up Host {hostport}
			header_up X-Forwarded-For {client_ip}
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
				read_timeout 10s
				write_timeout 10s
			}
		}
	}

	handle /ready {
		reverse_proxy api:8080 {
			header_up Host {hostport}
			header_up X-Forwarded-For {client_ip}
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
				read_timeout 10s
				write_timeout 10s
			}
		}
	}

	handle /ws {
		reverse_proxy api:8080 {
			header_up Host {hostport}
			header_up X-Forwarded-For {client_ip}
			transport http {
				dial_timeout 5s
				read_timeout 0
				write_timeout 0
			}
		}
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy api:8080 {
			header_up Host {hostport}
			header_up X-Forwarded-For {client_ip}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 60s
				write_timeout 60s
			}
		}
	}

	# Prometheus scrapes media:8081/metrics on the compose network; media itself
	# no longer serves /media/metrics. Keep this rule for older media images.
	handle /media/metrics {
		respond 404
	}

	@media path /media /media/*
	handle @media {
		reverse_proxy media:8081 {
			header_up Host {hostport}
			header_up X-Forwarded-For {client_ip}
			transport http {
				dial_timeout 5s
				read_timeout 0
				write_timeout 0
			}
		}
	}

	handle {
		reverse_proxy web:80 {
			header_up Host {hostport}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 30s
				write_timeout 30s
			}
		}
	}
}
