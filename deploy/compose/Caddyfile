{
	auto_https off
}

# TCP only. coturn and SFU ICE bind UDP themselves.
# /ws compares Origin to Host — pass Host through or the handshake is 403.
# {hostport}, not {host}: the browser's Origin carries a non-default port
# (GELABBER_HTTP_PORT, a proxy on :8443), and {host} would drop it.
:80 {
	# API JSON and whatever the web container did not compress itself.
	encode zstd gzip

	handle /health {
		reverse_proxy api:8080 {
			header_up Host {hostport}
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
				read_timeout 10s
				write_timeout 10s
			}
		}
	}

	handle /ready {
		reverse_proxy api:8080 {
			header_up Host {hostport}
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
				read_timeout 10s
				write_timeout 10s
			}
		}
	}

	handle /ws {
		reverse_proxy api:8080 {
			header_up Host {hostport}
			transport http {
				dial_timeout 5s
				read_timeout 0
				write_timeout 0
			}
		}
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy api:8080 {
			header_up Host {hostport}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 60s
				write_timeout 60s
			}
		}
	}

	# Prometheus scrapes the internal listener; never publish metrics.
	handle /media/metrics {
		respond 404
	}

	@media path /media /media/*
	handle @media {
		reverse_proxy media:8081 {
			header_up Host {hostport}
			transport http {
				dial_timeout 5s
				read_timeout 0
				write_timeout 0
			}
		}
	}

	handle {
		reverse_proxy web:80 {
			header_up Host {hostport}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 30s
				write_timeout 30s
			}
		}
	}
}
