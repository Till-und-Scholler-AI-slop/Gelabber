# Local `cargo run -p gelabber-api` (Compose injects the same names).
# Config comes exclusively from the environment; no file is read.
API_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://gelabber:gelabber@127.0.0.1:5432/gelabber
REDIS_URL=redis://127.0.0.1:6379
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_ROOT_USER=gelabber
MINIO_ROOT_PASSWORD=gelabbergelabber
MINIO_BUCKET=gelabber

# Optional (defaults shown).
# Hard deadline per /ready dependency check (Postgres, Redis).
#API_READY_TIMEOUT_MS=2000
#API_DB_MAX_CONNECTIONS=5
# Add `Secure` to the session/CSRF cookies. Leave off for plain-HTTP dev
# (Compose/Caddy on http://localhost); set to true behind TLS.
#API_COOKIE_SECURE=false
# Session cookie + row lifetime.
#API_SESSION_TTL_HOURS=720
# Native WS gateway (issue #6): application heartbeat and silent-death
# timeout. Dead must be greater than the heartbeat interval.
#API_WS_HEARTBEAT_MS=15000
#API_WS_DEAD_MS=30000
# Bounded Redis replay buffer per topic (reconnect catch-up).
#API_WS_REPLAY=256
# Presence / typing (issue 8). Idle is per client and is not reset by
# heartbeat. Presence TTL must be greater than the heartbeat interval.
#API_WS_IDLE_MS=300000
#API_WS_PRESENCE_TTL_MS=45000
#API_WS_TYPING_TTL_MS=6000
# Browser-facing STUN/TURN (coturn). UDP is not through Caddy.
#TURN_URLS=stun:127.0.0.1:3478,turn:127.0.0.1:3478
#TURN_USERNAME=gelabber
#TURN_PASSWORD=gelabberturn
# Optional coturn REST secret. When set, each media ticket gets time-limited TURN creds.
#TURN_AUTH_SECRET=
#TURN_CRED_TTL_SECS=21600
# Short SFU join ticket lifetime (Redis gb:mt:{code}).
#MEDIA_TICKET_TTL_SECS=30
# Rate limits / upload quota (issue #16). 0 disables that bucket.
# Auth (login+register) per client IP per minute.
#API_RATE_AUTH_PER_MIN=20
# Other mutating /api calls per session (or IP) per minute.
#API_RATE_API_PER_MIN=180
# POST /api/channels/{id}/messages per session per minute.
#API_RATE_MSG_PER_MIN=60
# POST /api/channels/{id}/attachments per session per hour.
#API_RATE_UPLOAD_PER_HOUR=60
# Daily attachment bytes per user (pending + bound). 1 GiB default.
#API_UPLOAD_QUOTA_BYTES_PER_DAY=1073741824
# tracing filter; output is always JSON on stdout. Unparseable values stop
# the process like any other invalid variable.
#RUST_LOG=info
