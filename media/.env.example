# Local `cargo run -p gelabber-media` (Compose injects the same names).
MEDIA_ADDR=0.0.0.0:8081
REDIS_URL=redis://127.0.0.1:6379

# Native UDP listener of the first media worker, default 10000. Worker i
# binds port + i. Test port 0 lets each worker select one port from
# 20000..=30000. The UDP range stays outside Caddy.
#MEDIA_ICE_BIND=0.0.0.0:10000
# Native mediasoup workers (one CPU core each), default 1, at most 64.
#MEDIA_WORKERS=1
# Last published UDP port. Required with more than one worker and at least
# MEDIA_ICE_BIND port + MEDIA_WORKERS - 1; the service refuses to start otherwise.
#MEDIA_ICE_PORT_MAX=10000
#MEDIA_ADVERTISED_IP=127.0.0.1

# Browsers get STUN/TURN from the API ticket. This process is ICE-lite and
# does not read TURN_URLS.
#MEDIA_READY_TIMEOUT_MS=2000
# /ws closes a socket that has not joined a room this long after it opened or left.
#MEDIA_JOIN_DEADLINE_MS=10000
# Sockets that have not joined a room, per client address (rightmost
# X-Forwarded-For entry, else the TCP peer) and in total.
#MEDIA_PENDING_PER_IP=16
#MEDIA_PENDING_MAX=1024
# Joined sockets are pinged this often and closed once nothing arrived from
# them for the idle timeout (must be longer than the heartbeat).
#MEDIA_HEARTBEAT_MS=20000
#MEDIA_IDLE_TIMEOUT_MS=60000
#RUST_LOG=info
