# Local `cargo run -p gelabber-media` (Compose injects the same names).
MEDIA_ADDR=0.0.0.0:8081
REDIS_URL=redis://127.0.0.1:6379

# One shared native UDP listener, default 10000. Test port 0 selects one
# port from 20000..=30000. Compose's reserved range stays outside Caddy.
#MEDIA_ICE_BIND=0.0.0.0:10000
#MEDIA_ICE_PORT_MAX=10031
#MEDIA_ADVERTISED_IP=127.0.0.1

# Browsers get STUN/TURN from the API ticket. This process is ICE-lite and
# does not read TURN_URLS.
#MEDIA_READY_TIMEOUT_MS=2000
#RUST_LOG=info
