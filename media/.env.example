# Local `cargo run -p gelabber-media` (Compose injects the same names).
MEDIA_ADDR=0.0.0.0:8081
REDIS_URL=redis://127.0.0.1:6379

# Host ICE bind. Port 0 is ephemeral. UDP is not through Caddy.
#MEDIA_ICE_BIND=127.0.0.1:0
#MEDIA_ADVERTISED_IP=127.0.0.1

# SFU-side STUN/TURN (Compose uses the coturn service name).
#TURN_URLS=stun:127.0.0.1:3478,turn:127.0.0.1:3478
#TURN_USERNAME=gelabber
#TURN_PASSWORD=gelabberturn
#MEDIA_READY_TIMEOUT_MS=2000
#RUST_LOG=info
