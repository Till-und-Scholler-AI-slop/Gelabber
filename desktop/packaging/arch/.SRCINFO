pkgbase = gelabber-desktop
	pkgdesc = Gelabber desktop app: voice, screen share and Go Live with a native media core
	pkgver = 0.5.0dev
	pkgrel = 1
	url = https://github.com/Till-und-Scholler-AI-slop/Gelabber
	arch = x86_64
	license = MIT
	license = BSD-3-Clause
	depends = webkit2gtk-4.1
	depends = gtk3
	depends = libsoup3
	depends = glib2
	depends = gstreamer
	depends = gst-plugins-base
	depends = gst-plugins-good
	depends = libpulse
	depends = pipewire
	depends = xdg-desktop-portal
	depends = vulkan-icd-loader
	depends = mesa
	depends = libdrm
	optdepends = pipewire-pulse: microphone and speakers through PipeWire
	optdepends = xdg-desktop-portal-hyprland: screen share on Hyprland (Omarchy)
	optdepends = xdg-desktop-portal-gnome: screen share on GNOME
	optdepends = xdg-desktop-portal-kde: screen share on KDE Plasma
	optdepends = gst-plugins-bad: hardware H264 encoding (nvh264enc, vah264enc)
	optdepends = vulkan-driver: video window (nvidia-utils, vulkan-intel, vulkan-radeon)
	conflicts = gelabber-desktop-bin
	conflicts = gelabber-desktop-git
	options = !strip
	options = !debug
	source = gelabber-desktop-0.5.0dev-1.tar.gz::https://github.com/Till-und-Scholler-AI-slop/Gelabber/releases/download/v0.5.0-dev/gelabber-desktop-linux-x64.tar.gz
	sha256sums = SKIP

pkgname = gelabber-desktop
