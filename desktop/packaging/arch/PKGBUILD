# Maintainer: Gelabber <https://github.com/Till-und-Scholler-AI-slop/Gelabber>
#
# Binary package of the desktop app: installs the Linux build that the
# "Desktop native core" workflow attaches to a GitHub release. The release
# workflow sets pkgver, the source URL and the checksum with
# update-pkgbuild.sh and regenerates .SRCINFO; do not edit them by hand.
pkgname=gelabber-desktop
pkgver=0.5.0dev
pkgrel=1
pkgdesc='Gelabber desktop app: voice, screen share and Go Live with a native media core'
arch=('x86_64')
url='https://github.com/Till-und-Scholler-AI-slop/Gelabber'
license=('MIT' 'BSD-3-Clause')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libsoup3'
  'glib2'
  'gstreamer'
  'gst-plugins-base'
  'gst-plugins-good'
  'libpulse'
  'pipewire'
  'xdg-desktop-portal'
  'vulkan-icd-loader'
  'mesa'
  'libdrm'
)
optdepends=(
  'pipewire-pulse: microphone and speakers through PipeWire'
  'xdg-desktop-portal-hyprland: screen share on Hyprland (Omarchy)'
  'xdg-desktop-portal-gnome: screen share on GNOME'
  'xdg-desktop-portal-kde: screen share on KDE Plasma'
  'gst-plugins-bad: hardware H264 encoding (nvh264enc, vah264enc)'
  'vulkan-driver: video window (nvidia-utils, vulkan-intel, vulkan-radeon)'
)
conflicts=('gelabber-desktop-bin' 'gelabber-desktop-git')
options=('!strip' '!debug')
_asset=gelabber-desktop-linux-x64.tar.gz
source=("${pkgname}-${pkgver}-${pkgrel}.tar.gz::${url}/releases/download/v0.5.0-dev/${_asset}")
sha256sums=('SKIP')

package() {
  cd gelabber-desktop-linux-x64
  # The binary finds libgelabber_media.so next to itself ($ORIGIN rpath).
  install -Dm755 gelabber-desktop "${pkgdir}/opt/${pkgname}/gelabber-desktop"
  install -Dm755 libgelabber_media.so "${pkgdir}/opt/${pkgname}/libgelabber_media.so"
  install -Dm644 README.txt "${pkgdir}/usr/share/doc/${pkgname}/README.txt"
  install -Dm644 THIRD-PARTY-NOTICES.txt "${pkgdir}/usr/share/licenses/${pkgname}/THIRD-PARTY-NOTICES.txt"
  install -Dm755 /dev/stdin "${pkgdir}/usr/bin/gelabber-desktop" <<'SH'
#!/bin/sh
exec /opt/gelabber-desktop/gelabber-desktop "$@"
SH
  install -Dm644 gelabber-desktop.desktop "${pkgdir}/usr/share/applications/gelabber-desktop.desktop"
  install -Dm644 icon.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/gelabber-desktop.png"
}
