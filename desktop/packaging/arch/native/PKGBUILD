# Maintainer: Gelabber <https://github.com/Till-und-Scholler-AI-slop/Gelabber>
#
# The desktop app (desktop/gelabber): installs the tarball that the
# "Desktop native core" workflow attaches to a GitHub release
# (desktop/packaging/native/tarball.sh). From 0.9 on it is gelabber-desktop,
# the Tauri app's package name, so `pacman -Syu` upgrades a Tauri install into
# it; the settings stay. The release workflow sets pkgver, the source URL and
# the checksum with ../update-pkgbuild.sh and regenerates .SRCINFO; do not
# edit them by hand.
pkgname=gelabber-desktop
pkgver=0.9.0dev
pkgrel=1
pkgdesc='Gelabber desktop app: voice, chat and Live with a native media core'
arch=('x86_64')
url='https://github.com/Till-und-Scholler-AI-slop/Gelabber'
license=('MIT' 'BSD-3-Clause')
# No webkit2gtk-4.1, libsoup3 or gtk3: egui draws on Vulkan, the tray is
# a StatusNotifierItem over D-Bus. winit loads Wayland or X11 at run time.
depends=(
  'glibc'
  'gcc-libs'
  'glib2'
  'gstreamer'
  'gst-plugins-base'
  'gst-plugins-good'
  'libpulse'
  'pipewire'
  'xdg-desktop-portal'
  'vulkan-icd-loader'
  'mesa'
  'libdrm'
  'libxkbcommon'
  'wayland'
)
optdepends=(
  'pipewire-pulse: microphone and speakers through PipeWire'
  'xdg-desktop-portal-hyprland: screen share and push-to-talk on Hyprland (Omarchy)'
  'xdg-desktop-portal-gnome: screen share on GNOME'
  'xdg-desktop-portal-kde: screen share and push-to-talk on KDE Plasma'
  'vulkan-driver: the window (nvidia-utils, vulkan-intel, vulkan-radeon)'
  'libx11: the window on X11 (with libxcursor, libxrandr, libxi)'
  'libxkbcommon-x11: the keyboard on X11'
  'gst-plugins-bad: H264 and AV1 on the GPU (h264parse, av1parse; NVIDIA through nvcodec)'
  'gst-plugin-va: H264 and AV1 on Intel and AMD GPUs (VA-API)'
  'gst-libav: H264 decoding on the CPU (avdec_h264)'
)
# The beta package of the native app before 0.9.
replaces=('gelabber-desktop-native')
conflicts=('gelabber-desktop-native' 'gelabber-desktop-bin' 'gelabber-desktop-git')
options=('!strip' '!debug')
source=("${pkgname}-${pkgver}-${pkgrel}.tar.gz::${url}/releases/download/v0.9.0-dev/gelabber-native-linux-x64.tar.gz")
sha256sums=('SKIP')

package() {
  cd gelabber-native-linux-x64
  # The binary finds libgelabber_media.so next to itself ($ORIGIN rpath).
  install -Dm755 gelabber "${pkgdir}/opt/gelabber/gelabber"
  install -Dm755 libgelabber_media.so "${pkgdir}/opt/gelabber/libgelabber_media.so"
  install -Dm644 README.txt "${pkgdir}/usr/share/doc/${pkgname}/README.txt"
  install -Dm644 THIRD-PARTY-NOTICES.txt "${pkgdir}/usr/share/licenses/${pkgname}/THIRD-PARTY-NOTICES.txt"
  install -dm755 "${pkgdir}/usr/bin"
  ln -s /opt/gelabber/gelabber "${pkgdir}/usr/bin/gelabber"
  # The Tauri package's command, which keybinds and autostarts may call.
  ln -s /opt/gelabber/gelabber "${pkgdir}/usr/bin/gelabber-desktop"
  # gelabber is the app id of the window and the notifications.
  install -Dm644 gelabber.desktop "${pkgdir}/usr/share/applications/gelabber.desktop"
  install -Dm644 gelabber.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/gelabber.png"
}
