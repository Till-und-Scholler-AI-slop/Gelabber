# The Windows build's settings, as KEY=value lines: desktop-native.yml's
# core-windows loads them before it builds, third-party-notices.py reads them.
#
# The C runtime linked statically, so the app starts without the Visual C++
# redistributable.
RUSTFLAGS=-C target-feature=+crt-static
# The tests' mediasoup worker against the same static runtime; --vsenv is
# mediasoup's default and must stay when MESON_ARGS is set.
MESON_ARGS=--vsenv -Db_vscrt=mt
