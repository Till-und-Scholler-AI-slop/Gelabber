# libwebrtc and libmediasoupclient pins for the native desktop media core.
# Changing any value invalidates the CI cache and rebuilds libwebrtc.
#
# M140 (branch-heads/7339) is the libwebrtc line libmediasoupclient 3.5.x
# targets. The commit is 7339@{#2}.
WEBRTC_BRANCH=branch-heads/7339
WEBRTC_COMMIT=36ea4535a500ac137dbf1f577ce40dc1aaa774ef
# libmediasoupclient v3 head after 3.5.0 (deadlock fix #187, ortc sync #198,
# extract-rtp-capabilities crash fix #218). 3.5.1 has no tag yet.
LIBMEDIASOUPCLIENT_COMMIT=83923f96ef35143a4700b0f606963e59b29302eb
LIBSDPTRANSFORM_TAG=1.2.10
# Bump to force a libwebrtc rebuild when build-libwebrtc.sh changes behavior.
LIBWEBRTC_PACKAGE_REVISION=1
