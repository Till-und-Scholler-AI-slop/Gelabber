{
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "homepage": "https://github.com/Till-und-Scholler-AI-slop/Gelabber",
    "resources": {
      "bundle-input/gelabber_media.dll": "gelabber_media.dll",
      "package/README-windows.txt": "README.txt",
      "package/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English", "German"],
        "displayLanguageSelector": false
      }
    }
  }
}
