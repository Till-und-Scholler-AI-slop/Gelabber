# The app calls the API at /api on its own origin (Caddy in Compose, the Vite
# dev proxy below locally), so the httpOnly session cookie is sent without CORS.

# Optional Vite dev API/WebSocket target (default: http://127.0.0.1:8080).
# Useful when running a local Rust API alongside the Compose API.
# GELABBER_API_TARGET=http://127.0.0.1:8082

# Optional Vite dev SFU WebSocket target (default: http://127.0.0.1:8081).
# Run the matching local SFU when developing signaling/media changes.
# GELABBER_MEDIA_TARGET=http://127.0.0.1:8083

# Optional Vite dev /public-pages.json (default: 404, nothing published): a
# JSON file in its shape (deploy/README.md, "Public pages"), so the legal
# links under the sign-in card show. The parity stack uses the fixture:
# GELABBER_DEV_PUBLIC_PAGES=scripts/parity/public-pages.json
