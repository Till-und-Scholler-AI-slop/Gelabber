# Relative so the browser stays same-origin (Caddy in Compose, the Vite dev
# proxy to 127.0.0.1:8080 locally) and the httpOnly session cookie is sent
# without CORS.
VITE_API_BASE_URL=/api

# Optional Vite dev API/WebSocket target (default: http://127.0.0.1:8080).
# Useful when running a local Rust API alongside the Compose API.
# GELABBER_API_TARGET=http://127.0.0.1:8082

# Optional Vite dev SFU WebSocket target (default: http://127.0.0.1:8081).
# Run the matching local SFU when developing signaling/media changes.
# GELABBER_MEDIA_TARGET=http://127.0.0.1:8083
