{
  "name": "gelabber-web",
  "private": true,
  "version": "0.9.3",
  "type": "module",
  "engines": {
    "node": ">=26.8.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "node --require ./eslint-ts6-register.cjs ./node_modules/eslint/bin/eslint.js .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:pwa-smoke": "node scripts/smoke-pwa.mjs",
    "test:source-audio-smoke": "node scripts/smoke-source-audio.mjs",
    "test:phone-smoke": "node scripts/smoke-phone-layout.mjs",
    "test:chat-scroll-smoke": "node scripts/smoke-chat-scroll.mjs",
    "test:lazy-parts-smoke": "node scripts/smoke-lazy-parts.mjs",
    "test:browser-smoke": "node scripts/smoke-two-browsers.mjs",
    "test:e2e-app": "node scripts/e2e/run.mjs",
    "test:e2e-harness": "node scripts/e2e/harness.checks.mjs",
    "test:checks": "node scripts/checks.mjs",
    "test:call-sounds-smoke": "node scripts/smoke-call-sounds.mjs",
    "test:call-soak": "node scripts/e2e/call-soak.mjs",
    "test:e2e-held-renderer-control": "node scripts/e2e/held-renderer-native-control.mjs",
    "test:e2e-webapp-recovery": "node scripts/e2e/webapp-recovery.mjs",
    "test:e2e-accessibility": "node scripts/e2e/webapp-accessibility.mjs",
    "test:audio-smoke": "node scripts/smoke-audio-processing.mjs",
    "test:audio-dsp": "node scripts/audio/benchmark-rnnoise.mjs",
    "test:e2e-chat-workflows": "node scripts/e2e/chat-workflows.mjs",
    "test:reactions-smoke": "node scripts/smoke-reactions.mjs",
    "test:e2e-search-context": "node scripts/e2e/search-context.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-virtual": "3.14.24",
    "mediasoup-client": "3.26.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
